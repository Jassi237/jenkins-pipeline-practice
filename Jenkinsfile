pipeline{
    agent any

    stages{
        stage('Checkout'){
            steps{
                echo "Getting source code..."
            }
        } 

        stage('build'){
            steps{
                echo "Building the application..."
            }
        }

        stage('test'){
            steps{
                echo "Testing the application..."
            }
        }

        stage('deploy'){
            steps{
                echo "Deploying the application..."
            }
        }
    }
}